// ─────────────────────────────────────────────────────────────────────────────
// 90 — Your personal overrides for Niri + Custom Quickshell
// ─────────────────────────────────────────────────────────────────────────────

binds {
    Mod+Return { spawn "kitty"; }
    Super+A { spawn "quickshell" "ipc" "call" "applauncher" "toggle"; }
    Super+W { spawn "quickshell" "ipc" "call" "wallpaperselect" "toggle"; }
    Super+P { spawn "quickshell" "ipc" "call" "powermenu" "toggle"; }
        // Super+Alt+L { spawn "quickshell" "ipc" "call" "lockscreen" "lock"; }

    Super+Shift+1 { move-column-to-workspace 1; }
    Super+Shift+2 { move-column-to-workspace 2; }
    Super+Shift+3 { move-column-to-workspace 3; }
    Super+Shift+4 { move-column-to-workspace 4; }
    Super+Shift+5 { move-column-to-workspace 5; }
}

blur {
    passes 4
    offset 2.5
}

// 🖼️ Teknik 2 Wiki Niri: Swaybg Blur Wallpaper khusus di Overview Backdrop
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// 🪟 Layer rules for Quickshell Bar (Frosted Glass Backdrop Blur & Rounded Corners)
layer-rule {
    match namespace="quickshell:bar"
    geometry-corner-radius 20
    background-effect {
        blur true
    }
}

// 🪟 Layer rules for Quickshell overlays
layer-rule {
    match namespace="quickshell:popup"
    shadow {
        off
        softness 30
        spread 5
        offset x=0 y=4
    }
}

// 📱 Application Window Blur & Rounding Rules (xray false to blur windows below!)
window-rule {
    background-effect {
        blur true
        xray false
    }

    geometry-corner-radius 14
    clip-to-geometry true
}
